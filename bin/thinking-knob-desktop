#!/bin/sh
set -eu
# The native app authorizes the MCP peer and its two ancestors. An arbitrary
# Node from PATH breaks that chain even when the Codex child is signed.
node_binary=/Applications/ChatGPT.app/Contents/Resources/cua_node/bin/node
if [ ! -x "$node_binary" ]; then
  printf '%s\n' 'Thinking Knob requires the app-bundled signed Node runtime.' >&2
  exit 1
fi
export KNOB_NATIVE_BINARY=/Applications/ChatGPT.app/Contents/Resources/codex
exec "$node_binary" "$(dirname "$0")/codex-thinking-knob-desktop.mjs" "$@"
